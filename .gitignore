```
# Rust target directory
target/

# Cargo.lock if this is a library
Cargo.lock

# Environment variables
.env
.env.local
.env.*

# Logs
*.log

# Temporary files
*.tmp
*.temp

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/

# Rust-specific build artifacts
**/*.rs.bk
**/*.d
**/*.o
**/*.a
**/*.so
**/*.dylib
**/*.dll
**/*.exe

# Debug and release builds in target
target/debug/
target/release/
target/wasm32-unknown-unknown/
target/x86_64-unknown-linux-gnu/
target/x86_64-apple-darwin/
target/x86_64-pc-windows-msvc/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Dependencies
vendor/

# Documentation
doc/

# Runtime data
.pid
.log

# Rust toolchain
.rustup/

# Cargo registry
**/cargo/vendor/

# Build system
**/build/
**/dist/

# Compression artifacts
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
